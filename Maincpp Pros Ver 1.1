Motor RM(11, E_MOTOR_GEARSET_06, false, E_MOTOR_ENCODER_DEGREES);
Motor LM(15, E_MOTOR_GEARSET_06, true,  E_MOTOR_ENCODER_DEGREES);
Motor RB(1,  E_MOTOR_GEARSET_06, false, E_MOTOR_ENCODER_DEGREES);
