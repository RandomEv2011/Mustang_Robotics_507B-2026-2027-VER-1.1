void autonomous(void) {
    switch (startPos) {
        case RED_LEFT:
            if (autonStrategy == SIDEA)      auton_red_left();
            else if (autonStrategy == SIDEB) auton_red_left_alt();
            else                             auton_red_left_sideC();
            break;
        case RED_BOTTOM:
            if (autonStrategy == SIDEA)      auton_red_bottom();
            else if (autonStrategy == SIDEB) auton_red_bottom_alt();
            else                             auton_red_bottom_sideC();
            break;
        case BLUE_RIGHT:
            if (autonStrategy == SIDEA)      auton_blue_right();
            else if (autonStrategy == SIDEB) auton_blue_right_alt();
            else                             auton_blue_right_sideC();
            break;
        case BLUE_TOP:
            if (autonStrategy == SIDEA)      auton_blue_top();
            else if (autonStrategy == SIDEB) auton_blue_top_alt();
            else                             auton_blue_top_sideC();
            break;
    }
}

const char* startPosLabel(StartPosition pos) {
    switch (pos) {
        case RED_LEFT:   return "RED LEFT";
        case RED_BOTTOM: return "RED BOTTOM";
        case BLUE_RIGHT: return "BLUE RIGHT";
        case BLUE_TOP:   return "BLUE TOP";
        default:         return "UNKNOWN";
    }
}

const char* autonStrategyLabel(AutonStrategy strat) {
    switch (strat) {
        case SIDEA: return "SIDE A";
        case SIDEB: return "SIDE B";
        case SIDEC: return "SIDE C";
        default:    return "UNKNOWN";
    }
}

int applyDeadzone(int value, int deadzone) {
    if (abs(value) < deadzone) return 0;
    return value;
}

const int DRIVE_DEADZONE = 20;

void run_auton_selector(void) {
    // Keep this simple and portable in PROS.
    // You can replace this with a touch-driven selector later if needed.
    autonStrategy = SIDEA;
    startPos = RED_LEFT;
}

void typeOutLine(int row, const char* text, int char_delay_ms = 40) {
    char buffer[64];
    int len = 0;
    while (text[len] != '\0' && len < 63) len++;

    for (int i = 0; i < len; i++) {
        buffer[i] = text[i];
        buffer[i + 1] = '\0';
        lcd::clear_line(row);
        lcd::print(row, "%s", buffer);
        delay(char_delay_ms);
    }
}

void pre_auton(void) {
    run_auton_selector();
    imu.reset();
    while (imu.is_calibrating()) {
        delay(20);
    }

    lcd::clear();

    char sideLine[32];
    std::snprintf(sideLine, sizeof(sideLine), "INSERT %s", autonStrategyLabel(autonStrategy));
    typeOutLine(1, sideLine);

    char posLine[32];
    std::snprintf(posLine, sizeof(posLine), "INSERT %s", startPosLabel(startPos));
    typeOutLine(2, posLine);
}

void opcontrol(void) {
    while (true) {
        int axis3Value = applyDeadzone(master.get_analog(ANALOG_LEFT_Y), DRIVE_DEADZONE);
        int axis2Value = applyDeadzone(master.get_analog(ANALOG_RIGHT_Y), DRIVE_DEADZONE);

        setDriveLeft(axis3Value);
        setDriveRight(axis2Value);

        static bool r1WasPressed = false;
        static bool r2WasPressed = false;
        bool r1Pressed = master.get_digital(DIGITAL_R1);
        bool r2Pressed = master.get_digital(DIGITAL_R2);

        if (r1Pressed && !r1WasPressed) {
            switch (liftState) {
                case LIFT_STATE_DOWN: liftState = LIFT_STATE_MID; lift_set_target(LIFT_MID_DEG); break;
                case LIFT_STATE_MID:  liftState = LIFT_STATE_UP;  lift_set_target(LIFT_UP_DEG);  break;
                case LIFT_STATE_UP:   liftState = LIFT_STATE_DOWN; lift_set_target(LIFT_DOWN_DEG); break;
            }
        }
        if (r2Pressed && !r2WasPressed) {
            liftState = LIFT_STATE_DOWN;
            lift_set_target(LIFT_DOWN_DEG);
        }
        r1WasPressed = r1Pressed;
        r2WasPressed = r2Pressed;

        delay(20);
    }
}

void initialize() {
    pre_auton();
    Task odomTask(odom_task_fn);
    Task liftTask(lift_task_fn);
}

